# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/leetcode_clone
SYNC_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/leetcode_clone

# Redis Configuration (Cache, Rate-limiter, Celery broker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AWS Cognito Configuration
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_examplepool
COGNITO_APP_CLIENT_ID=exampleclientid
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_examplepool
S3_BUCKET_NAME=leetcode-clone-storage
MOCK_S3=True

# Local Auth Demo Mode (True = no AWS account needed; False = live AWS Cognito)
MOCK_COGNITO=True
DEMO_JWT_SECRET=demo-local-jwt-secret-key-32-chars-min
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Judge0 Configuration
JUDGE0_URL=http://localhost:2358
JUDGE0_CALLBACK_URL=http://api:8000/internal/judge0-callback

# Rate Limiting Defaults
RATE_LIMIT_RUN_PER_MINUTE=10
RATE_LIMIT_RUN_PER_DAY=100
